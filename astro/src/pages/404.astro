---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | Ross Imlach" noindex>
  <main>
    <a class="name" href="/">Ross Imlach</a>
    <h1>This page isn’t here.</h1>
    <p>The link may have changed. You can find the work here:</p>
    <nav aria-label="Find your way"><a href="/#image">Image</a><a href="/#experience">Experience</a><a href="/engineering/">In the weeds</a></nav>
  </main>
</Base>
<style>
  main { max-width: 900px; margin: auto; padding: 40px 24px 100px; }
  .name { font-size: 18px; font-weight: 600; }
  h1 { margin: 100px 0 24px; font-size: clamp(40px, 7vw, 72px); font-weight: 500; line-height: 1; letter-spacing: -.04em; }
  p { color: var(--ink-dim); }
  nav { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 32px; }
  nav a { text-decoration: underline; text-underline-offset: 5px; }
</style>
