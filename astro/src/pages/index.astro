---
import Base from "../layouts/Base.astro";
import CreativeLanding from "../components/CreativeLanding.astro";
---
<Base title="Ross Imlach | Image & experience" description="Ross Imlach, Director of Photography. Lighting, video and creative direction for live performance. Based in Scotland.">
  <main class="landing">
    <CreativeLanding heading="h1" />
  </main>
</Base>
<style>
  .landing { max-width: 1480px; margin: 0 auto; padding: 24px 40px 0; }
  @media (max-width: 700px) { .landing { padding: 0; } }
</style>
