---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import liveImg from "../../../images/liveevents.jpg";

const practice = [
  { title: "Lighting design", description: "A visual approach built around the music, the performers and the space. Shape, colour and movement, with room for darkness too." },
  { title: "Video", description: "Live visuals and playback considered alongside the lighting. Developing and preparing images that belong in the same show." },
  { title: "Production", description: "Taking the idea into the room. Planning, programming and operating, with the creative intent carried through to the performance." },
];
---

<Base title="Live | Ross Imlach" description="Lighting design, video and creative direction for live performance. Ross Imlach, based in Scotland.">
  <main class="live-page">
    <nav class="live-nav" aria-label="Main navigation">
      <a class="name" href="/#experience">Ross Imlach</a>
      <div><a href="/cinematography/">Film</a><a href="/engineering/">In the weeds</a><a href="/about/">About</a><a href="mailto:ross@imla.ch">Contact</a></div>
    </nav>

    <header class="performance-hero">
      <Image src={liveImg} alt="A lighting desk overlooking a stage, with beams of light above the audience." widths={[640, 960, 1600]} sizes="(max-width: 700px) 100vw, calc(100vw - 80px)" loading="eager" fetchpriority="high" />
      <div class="performance-heading"><h1>For the music.<br />For the room.</h1><p>Lighting, video &amp; creative direction<br class="desktop-break" /> for live music and performance.</p></div>
    </header>

    <section class="approach" aria-labelledby="approach-title">
      <h2 id="approach-title">Start with<br />the performance.</h2>
      <div>
        <p class="lead">I work with artists to develop a visual language for their performance, and with the crew to bring it to life.</p>
        <p>The music, the people on stage and the space around them. I design lighting that gives each show its own visual character, with video considered as part of the same picture.</p>
        <p>I can help develop the visual direction from the start, or join an existing team to design, programme and operate the lighting.</p>
      </div>
    </section>

    <section class="practice" aria-label="Areas of practice">
      {practice.map(item => <article><h2>{item.title}</h2><p>{item.description}</p></article>)}
    </section>

    <section class="background" aria-labelledby="background-title">
      <h2 id="background-title">Across stage and screen.</h2>
      <div>
        <p>I began working in live events in the mid-2000s. My early work spanned theatre, music, dance, rental and production houses, from hands-on crew roles to lighting design and project management.</p>
        <p>I later moved toward engineering and cinematography, while continuing to take on live projects. Since 2025, live performance has become a renewed focus, alongside work in virtual production. I bring that mix of visual and technical experience to the shows I work on today.</p>
      </div>
    </section>

    <section class="tools" aria-labelledby="tools-title">
      <h2 id="tools-title">Tools &amp; production</h2>
      <div>
        <p>I work across grandMA3, Resolume Arena, TouchDesigner and Blender. Dedicated control, video and projection systems are available where the project calls for them. Previsualisation and rendering capacity support the preparation of shows and more complex content.</p>
        <details>
          <summary>View technical setup</summary>
          <dl>
            <div><dt>Lighting control</dt><dd>grandMA3 onPC setup, built into a single case.</dd></div>
            <div><dt>Video playback</dt><dd>A dedicated Resolume Arena system.</dd></div>
            <div><dt>Real-time visuals</dt><dd>MacBook Pro and Mac Studio available for TouchDesigner.</dd></div>
            <div><dt>Preparation</dt><dd>Previsualisation options and a render farm for complex content builds.</dd></div>
            <div><dt>Projection</dt><dd>2 × Christie WU14K-M projectors and a multitude of materials.</dd></div>
            <div><dt>Connectivity</dt><dd>Art-Net nodes and supporting control and networking equipment.</dd></div>
          </dl>
        </details>
      </div>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <div><h2 id="contact-title">What are you putting on?</h2><p>An early idea, a date in the diary or a show already taking shape.</p></div>
      <a href="mailto:ross@imla.ch?subject=Live%20enquiry">ross@imla.ch</a>
    </section>
    <footer class="live-footer"><span>Based in Scotland. Working wherever the project takes me.</span><div><a href="/#experience">Image | experience</a><a href="https://studio.imla.ch/">The Studio</a></div></footer>
  </main>
</Base>

<style>
  .live-page { max-width: 1480px; padding: 24px 40px 0; margin: auto; }
  .live-nav { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; padding: 26px 0; font-size: 14px; }
  .name { font-size: 18px; font-weight: 600; }
  .live-nav > div { display: flex; gap: 24px; flex-wrap: wrap; }
  a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .performance-hero { position: relative; height: min(760px, 80svh); min-height: 550px; isolation: isolate; margin-top: 24px; }
  .performance-hero img { width: 100%; height: 100%; object-fit: cover; object-position: center 55%; }
  .performance-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg,rgba(0,0,0,.85),transparent 85%); }
  .performance-heading { position: absolute; inset: auto 40px 36px; z-index: 1; }
  h1 { font-size: clamp(48px, 7.4vw, 106px); font-weight: 500; line-height: .98; letter-spacing: -.055em; margin: 0 0 24px; }
  .performance-heading p { font-size: 22px; line-height: 1.4; margin: 0; }
  .approach { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; margin: 96px 0 72px; }
  .approach h2 { font-size: clamp(36px, 4.6vw, 62px); line-height: 1.05; font-weight: 500; letter-spacing: -.04em; margin: 0; }
  .approach p { max-width: 52ch; color: #aaa69f; margin: 0 0 22px; }
  .approach .lead { color: #ede8dd; font-size: 25px; line-height: 1.4; letter-spacing: -.025em; }
  .practice { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .practice article { padding-top: 24px; border-top: 1px solid #55545a; }
  .practice h2 { font-size: 26px; line-height: 1.2; font-weight: 500; letter-spacing: -.025em; margin: 0 0 18px; }
  .practice p { color: #aaa69f; max-width: 40ch; margin: 0; }
  .background, .tools { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; margin-top: 72px; padding-top: 32px; border-top: 1px solid #343438; }
  .background h2, .tools h2 { font-size: 26px; line-height: 1.2; font-weight: 500; letter-spacing: -.025em; margin: 0; }
  .background p, .tools p { color: #aaa69f; max-width: 52ch; margin: 0 0 20px; }
  .tools summary { cursor: pointer; padding: 10px 0; font-size: 16px; width: fit-content; }
  .tools summary:hover { color: #fff; }
  .tools dl { margin: 12px 0 0; }
  .tools dl > div { display: grid; grid-template-columns: 140px 1fr; gap: 24px; border-top: 1px solid #343438; padding: 18px 0; font-size: 15px; }
  .tools dt { color: #ede8dd; }
  .tools dd { color: #aaa69f; margin: 0; max-width: 42ch; }
  .contact { margin-top: 96px; padding: 40px 0; border-block: 1px solid #55545a; display: flex; gap: 32px; align-items: center; justify-content: space-between; }
  .contact h2 { font-size: clamp(30px, 3.4vw, 44px); line-height: 1.1; font-weight: 500; letter-spacing: -.03em; margin: 0 0 14px; }
  .contact p { color: #aaa69f; margin: 0; max-width: 48ch; }
  .contact > a { font-size: 24px; border-bottom: 1px solid #aaa69f; white-space: nowrap; }
  .live-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 24px; color: #aaa69f; font-size: 13px; padding: 28px 0 40px; }
  .live-footer > div { display: flex; gap: 24px; }
  @media (max-width: 1000px) {
    .approach, .background, .tools { gap: 40px; }
    .practice { gap: 24px; }
  }
  @media (max-width: 700px) {
    .live-page { padding: 0 22px; }
    .live-nav { padding: 22px 0; }
    .live-nav > div { gap: 16px; font-size: 12px; }
    .approach, .practice, .background, .tools { grid-template-columns: 1fr; gap: 28px; }
    h1 { font-size: clamp(42px, 9.5vw, 66px); }
    .performance-hero { margin: 16px -22px 0; height: 68svh; min-height: 480px; }
    .performance-heading { inset: auto 22px 28px; }
    .performance-heading p { font-size: 17px; }
    .desktop-break { display: none; }
    .approach { margin: 56px 0 40px; }
    .approach .lead { font-size: 23px; }
    .background, .tools { margin-top: 40px; padding-top: 24px; }
    .tools dl > div { grid-template-columns: 1fr; gap: 6px; }
    .contact { margin-top: 56px; flex-direction: column; align-items: start; }
  }
</style>
