---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import liveImg from "../../../images/liveevents.jpg";

const services = [
  { title: "Lighting", description: "Design, programming and operation. Building a look around the performance, then making it work in the room.", detail: "grandMA2 / grandMA3" },
  { title: "Video", description: "Live visuals and playback, with content and lighting designed to work together. From preparing the images to running the show.", detail: "Resolume" },
  { title: "Design & production", description: "Bringing the visual idea and the technical plan together. Working through what a show needs, how it fits the space, and how it gets delivered.", detail: "From concept to show" },
];
---

<Base title="Live - Ross Imlach" description="Live lighting, video, design and production by Ross Imlach. Based in Scotland. From the first idea to the last cue.">
  <nav class="nav" aria-label="Main navigation">
    <div class="nav-wordmark">
      <a href="/" class="name">Ross Imlach</a>
      <span class="crumb"><span class="here">Live</span></span>
    </div>
    <div class="nav-links">
      <a href="/cinematography">Cinematography</a>
      <a href="/engineering">In the weeds</a>
      <a href="/about">About</a>
    </div>
  </nav>

  <main class="stage">
    <header class="live-hero">
      <Image src={liveImg} alt="A lighting desk overlooking a live stage, with beams of light above the audience." widths={[640, 960, 1600]} sizes="(max-width: 900px) 100vw, calc(100vw - 80px)" loading="eager" fetchpriority="high" />
      <div class="hero-copy">
        <h1>Live.</h1>
        <p>Lighting, video,<br />design &amp; production.</p>
      </div>
    </header>

    <section class="live-intro" aria-labelledby="live-heading">
      <h2 id="live-heading">From the first idea<br />to the last cue.</h2>
      <div>
        <p>I work across lighting, video, design and production for live shows
          and events. Sometimes that means joining a crew at the desk.
          Sometimes it means helping shape the show from the start.</p>
        <p>Based in Scotland, with a background in cinematography and engineering.
          The look and the systems behind it are both part of the work.</p>
        <a class="text-link" href="mailto:ross@imla.ch?subject=Live%20enquiry">Talk about a show</a>
      </div>
    </section>

    <section class="services" aria-label="Live services">
      {services.map((service) => (
        <article class="service">
          <h2>{service.title}</h2>
          <p>{service.description}</p>
          <span>{service.detail}</span>
        </article>
      ))}
    </section>

    <footer class="folio">
      <span>imla.ch / live · <a href="https://studio.imla.ch/">The Studio</a></span>
      <span>Tell me what you're planning · <a href="mailto:ross@imla.ch">ross@imla.ch</a></span>
    </footer>
  </main>
</Base>

<style>
  .live-hero { position: relative; min-height: 560px; height: min(720px, 76svh); overflow: hidden; background: var(--bg-3); }
  .live-hero img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: center 55%; }
  .live-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.72), rgba(0,0,0,.12) 75%), linear-gradient(0deg, rgba(0,0,0,.7), transparent 65%); }
  .hero-copy { position: absolute; left: 48px; bottom: 44px; z-index: 1; }
  .hero-copy h1 { font-size: clamp(100px, 15vw, 210px); font-weight: 500; line-height: .85; letter-spacing: -.055em; margin: 0 0 30px; }
  .hero-copy p { font-size: clamp(24px, 3vw, 38px); line-height: 1.2; letter-spacing: -.02em; margin: 0; }
  .live-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; max-width: 1100px; margin-top: 80px; }
  .live-intro h2 { font-size: clamp(30px, 3.6vw, 48px); line-height: 1.15; letter-spacing: -.03em; font-weight: 500; margin: 0; }
  .live-intro p { color: var(--ink-dim); max-width: 56ch; margin: 0 0 20px; }
  .text-link { display: inline-block; border-bottom: 1px solid var(--accent); padding-bottom: 3px; }
  .text-link:hover { color: var(--accent); }
  .services { margin-top: 72px; }
  .service { display: grid; grid-template-columns: 1fr 1.4fr .6fr; gap: 40px; align-items: baseline; border-top: 1px solid var(--rule); padding: 32px 0; }
  .service h2 { margin: 0; font-size: clamp(25px, 2.8vw, 36px); font-weight: 500; line-height: 1.2; letter-spacing: -.02em; }
  .service p { margin: 0; max-width: 56ch; color: var(--ink-dim); }
  .service > span { color: var(--ink-dim); font-size: 14px; text-align: right; }
  @media (max-width: 900px) {
    .live-hero { min-height: 500px; height: 70svh; }
    .hero-copy { left: 28px; bottom: 32px; }
    .live-intro { grid-template-columns: 1fr; gap: 24px; margin-top: 48px; }
    .service { grid-template-columns: 1fr; gap: 16px; }
    .service > span { text-align: left; }
  }
  @media (max-width: 480px) {
    .live-hero { min-height: 440px; height: 65svh; }
    .hero-copy { left: 24px; right: 24px; }
  }
</style>
