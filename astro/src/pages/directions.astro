---
import Base from "../layouts/Base.astro";
import { Image, getImage } from "astro:assets";
import tobias from "../assets/references/tobias.webp";
import luke from "../assets/references/luke.webp";
import treatment from "../assets/references/treatment.webp";
import uva from "../assets/references/uva.webp";
import fray from "../assets/references/fray.webp";
import rob from "../assets/references/rob.webp";
import filmImg from "../assets/films/skin/3.jpg";
import { lightingStudies } from "../data/lightingStudies";

const film = await getImage({src:filmImg, width:1200, format:"webp"});
const lighting = await Promise.all(lightingStudies.map(async item => ({
  ...item,
  optimized: await getImage({src:item.image, width:Math.min(1600,item.image.width), format:"webp"}),
})));
const live = lighting[0].optimized;
const blue = lighting[1];
const crossed = lighting[3];
const references = [
  {name:"Tobias Rylander", href:"https://tobiasrylander.com/", image:tobias, title:"The image makes the introduction.", note:"A whole stage fills the opening frame. Quiet navigation and generous project titles leave the atmosphere intact.", take:"Give a show the whole width. Let the work introduce Ross before a list of services.", caption:"The 1975 • image from Tobias Rylander’s portfolio", class:"wide"},
  {name:"Luke Halls Studio", href:"https://lukehalls.com/", image:luke, title:"One visual practice, many settings.", note:"Overlapping images lead into a portfolio organised by context: music, theatre, fashion and live events.", take:"Film and live can feel like the same eye at work, with clear routes into each.", caption:"Homepage imagery • Luke Halls Studio", class:"wide"},
  {name:"United Visual Artists", href:"https://www.uva.co.uk/", image:uva, title:"Space is part of the identity.", note:"The landing uses offset images and unusually large areas of white space. Light, objects and systems sit within one body of work.", take:"Let image proportions and placement carry the character. The grid can be quieter.", caption:"Seven Suns • United Visual Artists", class:"small"},
  {name:"Treatment Studio", href:"https://www.treatmentstudio.com/work/", image:treatment, title:"A portfolio with rhythm.", note:"A clean, light gallery varies the size and orientation of projects. The work supplies the colour and energy.", take:"Use a few carefully chosen projects in different sizes, with precise role credits.", caption:"Jay Z • image from Treatment Studio’s work index", class:"small"},
  {name:"FRAY Studio", href:"https://fraystudio.com/", image:fray, title:"Design is felt at show scale.", note:"The opening is an image-led live-performance statement. Their positioning connects video design directly to the audience’s experience.", take:"Show the intended feeling and the resulting performance before naming the tools.", caption:"Joji • homepage imagery from FRAY Studio", class:"small"},
  {name:"Rob Sinclair", href:"https://www.robsinclair.com/", image:rob, title:"The person can be the identity.", note:"Large project photographs and a compact archive sit under the designer’s own name. The About page has a distinct personal voice.", take:"A confident Ross Imlach identity can carry this. A finished studio brand can come later.", caption:"My Chemical Romance • image from Rob Sinclair’s portfolio", class:"small"},
];
---

<Base title="Creative direction studies - Ross Imlach" description="A working mood board and three landing-page studies for Ross Imlach." noindex>
  <main class="research">
    <header class="board-header">
      <a href="/">Ross Imlach</a>
      <span>Working direction • September 2026</span>
      <a href="#studies">Explore the landings</a>
    </header>

    <section class="opening">
      <h1>A point of view.<br />Then, the work.</h1>
      <div class="opening-copy">
        <p>Lead with the creative eye. Film and live show what it looks like.
          The notebook shows how it gets made.</p>
        <p class="quiet">A working mood board for a personal creative practice.
          Studio stays a quiet link while its identity develops.</p>
      </div>
    </section>

    <nav class="board-nav" aria-label="Mood board sections">
      <a href="#your-images">Your lighting images</a>
      <a href="#references">Peer references</a>
      <a href="#language">Visual language</a>
      <a href="#studies">Three landing studies</a>
      <a href="#positioning">Voice &amp; structure</a>
    </nav>

    <section id="your-images" aria-labelledby="images-title">
      <div class="section-heading">
        <h2 id="images-title">The feeling in the room.</h2>
        <p>Your six supplied images. The warm crowd leads study A, the blue room anchors B, and the crossed beams give C its vertical composition.</p>
      </div>
      <div class="lighting-grid">
        {lighting.map(item => (
          <figure class:list={["lighting-image", {landscape:item.landscape}]}>
            <Image src={item.image} alt={item.alt} widths={[320,640]} sizes="(max-width: 700px) 100vw, 50vw" loading="lazy" />
            <figcaption><h3>{item.name}</h3><p>{item.note}</p></figcaption>
          </figure>
        ))}
      </div>
      <p class="credits">Supplied by Ross for these sketches. Descriptive working titles; project names, roles and photographer credits can follow with the final selection.</p>
    </section>

    <section id="references" aria-labelledby="references-title">
      <div class="section-heading">
        <h2 id="references-title">What to draw from.</h2>
        <p>Personal portfolios and larger studios: references for presentation and positioning, rather than a comparison of scale.</p>
      </div>
      <div class="reference-grid">
        {references.map(ref => (
          <figure class={`reference ${ref.class}`}>
            <a class="reference-image" href={ref.href} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${ref.name}`}>
              <Image src={ref.image} alt={ref.caption} widths={[480,1000]} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 50vw" loading="lazy" />
            </a>
            <figcaption>
              <a class="source-name" href={ref.href} target="_blank" rel="noopener noreferrer">{ref.name} <span aria-hidden="true">↗</span></a>
              <h3>{ref.title}</h3>
              <p>{ref.note}</p>
              <p class="take">For Ross: {ref.take}</p>
              <small>{ref.caption}</small>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="credits">Reference photographs belong to their respective creators. Sources are linked above; these are peer projects, not Ross’s work. Website observations made 20 September 2026. The interpretations are ours.</p>
    </section>

    <section id="language" class="language" aria-labelledby="language-title">
      <div>
        <h2 id="language-title">Let light supply the colour.</h2>
        <p>Keep Schibsted Grotesk and the warmth already in the site. Give the images
          space, preserve their colour, and use type with more confidence.</p>
        <div class="swatches" aria-label="Proposed palette">
          <span style="--swatch:#0a0a0b">Stage<br />#0A0A0B</span>
          <span style="--swatch:#ede8dd">Projection<br />#EDE8DD</span>
          <span style="--swatch:#c5ccda">Daylight<br />#C5CCDA</span>
          <span style="--swatch:#c87a3a">Tungsten<br />#C87A3A</span>
        </div>
      </div>
      <div class="type-study">
        <span>Schibsted Grotesk / 500</span>
        <p>Light.<br />Image.<br />Feeling.</p>
        <small>One large statement. Quiet labels. Specific credits.</small>
      </div>
    </section>

    <section id="studies" aria-labelledby="studies-title">
      <div class="section-heading">
        <h2 id="studies-title">Three ways in.</h2>
        <p>Same direction, different structure. Try your lighting images in each layout. Project selections and copy are still a draft.</p>
      </div>
      <div class="image-choice">
        <label for="lighting-choice">Lighting image</label>
        <select id="lighting-choice">
          <option value="suggested">Suggested for each layout</option>
          {lighting.map(item => <option value={item.id} data-src={item.optimized.src} data-position={item.position} data-alt={item.alt} data-width={item.image.width} data-height={item.image.height}>{item.name}</option>)}
        </select>
        <span>Compare one image across A, B and C.</span>
      </div>
      <div class="study-picker" role="group" aria-label="Choose a landing study">
        <button type="button" data-study="feature" aria-pressed="true" aria-controls="study-feature">A. One opening image</button>
        <button type="button" data-study="pair" aria-pressed="false" aria-controls="study-pair">B. Film &amp; live</button>
        <button type="button" data-study="index" aria-pressed="false" aria-controls="study-index">C. A personal index</button>
      </div>

      <article class="study" id="study-feature">
        <div class="study-explanation"><h3>A. One opening image</h3><p>My starting point: a single image establishes the eye. Film and Live are direct links; the notebook follows below. Studio lives in the footer.</p></div>
        <div class="mockup feature-mockup">
          <nav class="mock-nav" aria-label="Featured landing study"><strong>Ross Imlach</strong><div><a href="/cinematography/">Film</a><a href="/live/">Live</a><a href="/engineering/">In the weeds</a><a href="mailto:ross@imla.ch">Contact</a></div></nav>
          <div class="feature-frame" style={`--frame:url('${live.src}'); --frame-position:50% 55%`}>
            <div class="feature-heading"><p>Lighting, image &amp; live performance.</p><h2>Something<br />you can feel.</h2><a href="/live/">Explore live work</a></div>
            <div class="frame-picker" role="group" aria-label="Featured image"><button type="button" data-frame={live.src} data-position="50% 55%" data-href="/live/" data-label="Explore live work" aria-pressed="true">Live</button><button type="button" data-frame={film.src} data-position="center" data-href="/cinematography/" data-label="Explore cinematography" aria-pressed="false">Film</button></div>
          </div>
          <div class="mock-note"><div><h3>In the weeds.</h3><p>Experiments, tools and things I’m working through.</p></div><a href="/engineering/cora-why/">Building a reviewer for my own code</a></div>
          <footer class="mock-footer"><span>Scotland. Working wherever the project takes me.</span><a href="https://studio.imla.ch/">The Studio</a></footer>
        </div>
        <p class="tradeoff">Best when a small, strong selection can carry the introduction. A still works today; a short reel could follow once the footage is chosen. The film/live switch above is manual.</p>
      </article>

      <article class="study" id="study-pair" hidden>
        <div class="study-explanation"><h3>B. Film &amp; live</h3><p>Two creative directions remain visible together. They share a name, a point of view and a notebook. Studio is a secondary destination.</p></div>
        <div class="mockup pair-mockup">
          <nav class="mock-nav" aria-label="Paired landing study"><strong>Ross Imlach</strong><div><a href="/engineering/">In the weeds</a><a href="/about/">About</a><a href="mailto:ross@imla.ch">Contact</a></div></nav>
          <header class="pair-intro"><h2>Images for the screen.<br />Light for the room.</h2><p>Cinematography, lighting and live production.<br />A creative practice based in Scotland.</p></header>
          <div class="pair-images"><a href="/cinematography/" style={`background-image:url('${film.src}')`}><h3>Film.</h3><span>Cinematography</span></a><a class="pair-live" href="/live/" style={`background-image:url('${blue.optimized.src}');background-position:${blue.position}`}><h3>Live.</h3><span>Lighting, video &amp; production</span></a></div>
          <div class="mock-note"><div><h3>In the weeds.</h3><p>What happens behind the image and under the hood.</p></div><a href="/engineering/">Read the notebook</a></div>
          <footer class="mock-footer"><span>Design, post and ongoing experiments.</span><a href="https://studio.imla.ch/">The Studio</a></footer>
        </div>
        <p class="tradeoff">The clearest choice if both film and live should be equally easy to enter. It keeps two entrances without putting engineering into a third promotional panel.</p>
      </article>

      <article class="study" id="study-index" hidden>
        <div class="study-explanation"><h3>C. A personal index</h3><p>Your name and the work form one composition. A large image sits beside a short index. This leaves the most room for the practice to evolve.</p></div>
        <div class="mockup index-mockup">
          <nav class="mock-nav" aria-label="Index landing study"><strong>Ross Imlach</strong><div><a href="/about/">About</a><a href="mailto:ross@imla.ch">Contact</a></div></nav>
          <div class="index-body"><div class="index-copy"><p>I work with light,<br />images and the systems<br />behind them.</p><div class="index-links"><a href="/cinematography/">Cinematography<span>Films, music videos &amp; shorts</span></a><a href="/live/">Live<span>Lighting, video &amp; production</span></a><a href="/engineering/">In the weeds<span>Notes from making things work</span></a></div></div><img src={crossed.optimized.src} alt={crossed.alt} width={crossed.image.width} height={crossed.image.height} loading="lazy" style={`object-position:${crossed.position}`} /></div>
          <footer class="mock-footer"><span>A practice in progress. Scotland.</span><a href="https://studio.imla.ch/">The Studio</a></footer>
        </div>
        <p class="tradeoff">The most flexible structure, and the least dependent on a reel. It keeps every route visible with different emphasis through type and placement.</p>
      </article>
      <noscript><p>The first study is shown above. Enable JavaScript to compare the other two.</p></noscript>
    </section>

    <section id="positioning" class="positioning" aria-labelledby="positioning-title">
      <h2 id="positioning-title">A personal practice.<br />Room to go deeper.</h2>
      <div class="positioning-grid">
        <div><h3>The front door</h3><p><strong>Ross Imlach.</strong> A clear creative point of view, expressed through film, lighting and live performance. Describe what the work feels like, then show the choices that made it happen.</p></div>
        <div><h3>The notebook</h3><p><strong>In the weeds.</strong> Experiments, working notes, tools and the systems behind them. Keep the engineering URLs; change the invitation and the voice.</p></div>
        <div><h3>The Studio</h3><p><strong>A quiet link, for now.</strong> Existing colour, sound and post work stays accessible. Its wider design and creative-direction identity can develop without holding up the personal site.</p></div>
      </div>
      <div class="voice-sample"><span>A possible notebook introduction</span><p>Things I’m building, breaking and figuring out. Sometimes for a show, sometimes for a film, sometimes because I wanted to see if I could make it work.</p></div>
      <p class="next-step">For the next pass: choose a landing structure, then pick a handful of live images with project names and your exact role. The most useful case study will connect the initial idea, a design decision, and what the audience saw.</p>
    </section>

    <footer class="board-footer"><span>Draft for discussion. A is the suggested starting point; B keeps the creative split clearest.</span><a href="/live/">Open the first Live page draft</a></footer>
  </main>
</Base>

<script>
  const studyButtons = document.querySelectorAll<HTMLButtonElement>("[data-study]");
  studyButtons.forEach(button => button.addEventListener("click", () => {
    studyButtons.forEach(item => item.setAttribute("aria-pressed", String(item === button)));
    document.querySelectorAll<HTMLElement>(".study").forEach(study => { study.hidden = study.id !== `study-${button.dataset.study}`; });
  }));
  const frameButtons = document.querySelectorAll<HTMLButtonElement>("[data-frame]");
  frameButtons.forEach(button => button.addEventListener("click", () => {
    const frame = document.querySelector<HTMLElement>(".feature-frame");
    const link = frame?.querySelector<HTMLAnchorElement>(".feature-heading a");
    if (!frame || !link) return;
    frame.style.setProperty("--frame", `url('${button.dataset.frame}')`);
    frame.style.setProperty("--frame-position", button.dataset.position || "center");
    link.href = button.dataset.href!;
    link.textContent = button.dataset.label!;
    frameButtons.forEach(item => item.setAttribute("aria-pressed", String(item === button)));
  }));

  const imageChoice = document.querySelector<HTMLSelectElement>("#lighting-choice");
  const pairLive = document.querySelector<HTMLElement>(".pair-live")!;
  const indexImage = document.querySelector<HTMLImageElement>(".index-body img")!;
  const liveButton = document.querySelector<HTMLButtonElement>('[data-frame][data-href="/live/"]')!;
  const suggested = {
    frame: liveButton.dataset.frame!, position: liveButton.dataset.position!,
    pair: pairLive.style.backgroundImage, pairPosition: pairLive.style.backgroundPosition,
    index: indexImage.src, indexPosition: indexImage.style.objectPosition,
    alt: indexImage.alt, width: indexImage.width, height: indexImage.height,
  };
  imageChoice?.addEventListener("change", () => {
    const option = imageChoice.selectedOptions[0];
    const reset = option.value === "suggested";
    const src = reset ? suggested.frame : option.dataset.src!;
    const position = reset ? suggested.position : option.dataset.position!;
    liveButton.dataset.frame = src;
    liveButton.dataset.position = position;
    liveButton.click();
    pairLive.style.backgroundImage = reset ? suggested.pair : `url('${src}')`;
    pairLive.style.backgroundPosition = reset ? suggested.pairPosition : position;
    indexImage.src = reset ? suggested.index : src;
    indexImage.alt = reset ? suggested.alt : option.dataset.alt!;
    indexImage.width = reset ? suggested.width : Number(option.dataset.width);
    indexImage.height = reset ? suggested.height : Number(option.dataset.height);
    indexImage.style.objectPosition = reset ? suggested.indexPosition : position;
  });
</script>

<style>
  .research { max-width: 1480px; padding: 32px 48px; margin: auto; color: #ede8dd; }
  .research p { max-width: 65ch; }
  .board-header, .board-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; font-size: 14px; }
  .board-header span, .quiet { color: #aaa69f; }
  .board-header a:last-child, .board-footer a { border-bottom: 1px solid #c87a3a; padding-bottom: 4px; }
  .opening { display: grid; grid-template-columns: 1.3fr 1fr; gap: 60px; align-items: end; margin: 110px 0 60px; }
  .opening h1 { font-size: clamp(48px, 6.5vw, 96px); font-weight: 500; line-height: .98; letter-spacing: -.055em; margin: 0; }
  .opening-copy p { font-size: 22px; line-height: 1.45; margin: 0 0 18px; }
  .opening-copy .quiet { font-size: 16px; margin: 0; }
  .board-nav { display: flex; gap: 28px; flex-wrap: wrap; padding: 24px 0; border-block: 1px solid #343438; font-size: 15px; }
  .board-nav a:hover { color: #c87a3a; }
  section[id] { scroll-margin-top: 30px; }
  .section-heading { display: flex; gap: 40px; justify-content: space-between; align-items: end; margin: 80px 0 32px; }
  .section-heading h2, .language h2, .positioning > h2 { font-size: clamp(30px, 3.5vw, 48px); line-height: 1.08; letter-spacing: -.03em; font-weight: 500; margin: 0; }
  .section-heading > p { max-width: 48ch; font-size: 16px; color: #aaa69f; margin: 0; }
  .reference-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 48px 28px; }
  .reference { margin: 0; grid-column: span 2; min-width: 0; }
  .reference.wide { grid-column: span 3; }
  .reference:nth-child(6) { grid-column: span 6; display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; align-items: center; }
  .reference-image { display: block; }
  .reference img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .reference.wide img { aspect-ratio: 16 / 10; }
