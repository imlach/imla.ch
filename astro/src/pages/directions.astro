  .frame-picker button { background: #171819; border: 1px solid #a8a7a2; color: #ede8dd; padding: 10px 14px; font: inherit; font-size: 14px; cursor: pointer; }
  .frame-picker button[aria-pressed="true"] { background: #ede8dd; color: #101112; }
  .mock-note { display: flex; gap: 24px; justify-content: space-between; align-items: center; padding: 36px 32px; border-bottom: 1px solid #686660; }
  .mock-note h3 { font-size: 28px; font-weight: 500; letter-spacing: -.03em; margin: 0 0 8px; }
  .mock-note p { font-size: 15px; margin: 0; }
  .mock-note > a { max-width: 25ch; font-size: 16px; text-decoration: underline; text-underline-offset: 4px; }
  .mock-footer { display: flex; gap: 24px; justify-content: space-between; padding: 24px 32px; font-size: 13px; }
  .pair-intro { padding: 36px 32px; display: flex; gap: 40px; align-items: end; justify-content: space-between; }
  .pair-intro h2 { font-size: clamp(32px, 4.5vw, 60px); line-height: 1; letter-spacing: -.045em; font-weight: 500; margin: 0; }
  .pair-intro p { font-size: 15px; max-width: 34ch; margin: 0; }
