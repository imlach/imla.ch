  .lighting-image.landscape { grid-column: span 6; }
  .lighting-image img { width: 100%; height: auto; display: block; }
  .lighting-image h3 { font-size: 20px; font-weight: 500; margin: 16px 0 8px; }
  .lighting-image p { font-size: 14px; color: #aaa69f; margin: 0; }
  .language { margin-top: 88px; padding-block: 48px; border-block: 1px solid #343438; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
  .language p { color: #aaa69f; }
  .swatches { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-top: 32px; }
  .swatches span { font-size: 12px; color: #aaa69f; }
  .swatches span::before { content: ""; display: block; height: 55px; margin-bottom: 10px; background: var(--swatch); border: 1px solid #343438; }
  .type-study { padding-left: 40px; border-left: 1px solid #343438; }
  .type-study > span, .type-study small { color: #aaa69f; font-size: 13px; }
