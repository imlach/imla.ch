---
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import ogStill from "../assets/live/warm-crowd.webp";

interface Props {
  title: string;
  description?: string;
  palette?: "dark" | "cream";
  noindex?: boolean;
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
}

const {
  title,
  description = "Ross Imlach - cinematography, live lighting, video, design and production, and platform engineering. Based in Scotland.",
  palette = "dark",
  noindex = false,
  socialImage = ogStill,
  socialImageAlt = "An audience in warm orange light at a live performance.",
} = Astro.props;

// Social preview - a graded still. JPEG, not WebP: some scrapers
// (LinkedIn among them) still won't render WebP og:images.
const og = await getImage({ src: socialImage, width: 1200, format: "jpeg" });
const canonicalUrl = new URL(Astro.url.pathname, "https://imla.ch");
const preventIndexing = noindex || process.env.SITE_PREVIEW === "true";
const ogImageUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {preventIndexing && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicons/04-r-period-dark.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicons/04-r-period-light.svg" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/favicons/04-r-period-dark.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:width" content={og.attributes.width} />
    <meta property="og:image:height" content={og.attributes.height} />
    <link rel="alternate" type="application/rss+xml" title="In the weeds" href="/engineering/feed.xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
